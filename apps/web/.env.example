# Lidas só pelo servidor de desenvolvimento (vite.config.ts). Sem prefixo VITE_, não entram no bundle.
# Diretório raiz das publicações locais; padrão: <repositório>/.local/publications
ELEICOES_PUBLICATIONS_DIR=

# Públicas: o Vite copia VITE_* para o JavaScript no momento do build. Nunca coloque segredo aqui.
# Mudar estes valores exige um build novo; não há configuração em tempo de execução.
# Base HTTP dos resultados. O web lê <base>/<canal>/manifest.json e <base>/<canal>/snapshots/<uuid>.json.
# https obrigatório; http só com a página e os dados em loopback. Sem usuário, senha, query ou fragmento.
# Vazia em desenvolvimento: usa a ponte /publications/ do servidor do Vite. Vazia no build: a tela recusa e não consulta nada.
VITE_RESULTS_BASE_URL=
# Canal nacional de presidente, <prefixo>-presidente-br-<turno>t. Os canais de UF e de governador saem do mesmo
# prefixo e turno (<prefixo>-presidente-sp-2t, <prefixo>-governador-df-2t). Obrigatório com a base; padrão em
# desenvolvimento sem base: demo-sintetico-presidente-br-2t.
VITE_RESULTS_CHANNEL=
# Idade, em milissegundos inteiros, a partir da qual a tela avisa que não há verificação ou coleta recente.
# Vazio em desenvolvimento: 120000 (valor local, não é meta de produção). Obrigatório no build.
VITE_RESULTS_STALE_AFTER_MS=
# Espera, em milissegundos inteiros, entre o fim de uma leitura do manifesto e o início da próxima, por aba aberta.
# Vazio em desenvolvimento: 5000 (valor local). Obrigatório no build; produção usa de 15000 a 30000.
VITE_RESULTS_POLL_INTERVAL_MS=
# Hosts aceitos como loopback, separados por vírgula. http só é aceito quando a página e a base estão nesta lista.
# Vazia: http nunca é aceito. Só hosts, sem esquema, porta ou caminho. Ex.: 127.0.0.1,[::1]
VITE_RESULTS_LOOPBACK_HOSTS=
# Domínios que a base nunca pode usar (inclui subdomínios), separados por vírgula. Obrigatória quando há base. Ex.: tse.jus.br
VITE_RESULTS_BLOCKED_DOMAINS=
